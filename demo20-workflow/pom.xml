<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.chenmeng</groupId>
        <artifactId>chenmeng-test-demos</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>demo20-workflow</artifactId>
    <description>flowable工作流测试工程</description>

    <properties>
        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!--
            Flowable 工作流引擎（版本 6.8.0 由根 pom 统一管理）。
            为什么是 flowable-spring-boot-starter-process 而不是 flowable-spring-boot-starter？
              - starter（全家桶）：额外引入 IDM（用户/组身份管理）、CMMN（案例管理）、DMN（决策表）、App 等模块，表会多建几十张，不适合学习；
              - starter-process（仅流程）：只包含 BPMN 流程引擎核心（RepositoryService / RuntimeService / TaskService / HistoryService），
                首次启动只建流程相关的 ACT_* 表，最贴近"理解引擎本身"的学习目标。
            版本约束：Flowable 6.x 支持 Spring Boot 2.x + Java 11；Flowable 7.x 要求 Spring Boot 3.x + Java 17，本项目禁止升级到 7.x。
            与 yudao 的对应关系：ruoyi-vue-pro 的 yudao-spring-boot-starter-bpm 同样基于 flowable-spring-boot-starter-process，
            只是 yudao 在其之上又封装了一层 BpmProcessInstanceApi / BpmTaskApi 供业务模块调用。
        -->
        <dependency>
            <groupId>org.flowable</groupId>
            <artifactId>flowable-spring-boot-starter-process</artifactId>
        </dependency>

        <!-- web：提供 REST 接口能力 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 参数校验：@NotBlank / @NotNull / @Min 等（版本跟随根 pom 的 springboot.version） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
            MyBatis-Plus：业务表（leave_apply）的 ORM 访问层。
            注意与 Flowable 的关系：Flowable 引擎自己的 ACT_* 表由引擎内部使用 MyBatis 访问（引擎自带、对我们透明），
            我们只用 MyBatis-Plus 访问业务表。两者底层都是 JDBC + MyBatis 体系，Spring 集成下共用同一个数据源和事务。
        -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-boot-starter</artifactId>
        </dependency>

        <!-- MySQL 驱动（版本由根 pom 统一管理） -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- knife4j 接口文档（swagger 增强 UI，版本由根 pom 统一管理），方便逐个调用接口体验流程闭环 -->
        <dependency>
            <groupId>com.github.xiaoymin</groupId>
            <artifactId>knife4j-spring-boot-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
